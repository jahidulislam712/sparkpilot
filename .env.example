# Core
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://sparkpilot:sparkpilot@127.0.0.1:5432/sparkpilot
DIRECT_DATABASE_URL=postgresql://sparkpilot:sparkpilot@127.0.0.1:5432/sparkpilot

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Email
EMAIL_MODE=console
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@sparkpilot.local

# AI providers
LLM_PROVIDER=fake
LLM_AGENT_MODEL=
LLM_CHAT_MODEL=
LLM_BATCH_MODEL=
EMBEDDING_PROVIDER=fake
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Worker
WORKER_MODE=inline

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Observability
SENTRY_DSN=

# Web
NEXT_PUBLIC_API_URL=http://127.0.0.1:3000
NEXT_PUBLIC_WIDGET_URL=http://127.0.0.1:3001
