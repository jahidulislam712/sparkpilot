// use prisma-8
// SparkPilot (DevSparkr) - Prisma ORM 8 contract. Target: PostgreSQL + pgvector.
// Verified: `prisma contract emit` and `prisma migration plan` succeed on prisma 8.0.0-rc.35.
// Conventions: every model has createdAt/updatedAt; tenant tables carry organizationId;
// parent-child tables use COMPOSITE FKs so a child can never point at another tenant's parent.
// IDs are generated by the client (@onCreate(cuid(2))): raw-SQL inserts (e.g. Chunk + vector) must supply an id.
// Enable the `vector` extension BEFORE the first migrate (compose init script / Neon SQL editor).
// Things the contract cannot express are added in a hand-authored migration (see TASKS.md P2-03):
//   HNSW index on Chunk.embedding; GIN index on to_tsvector(Chunk.content);
//   partial unique index (one live Subscription per org); composite FKs for optional Ticket/Lead.conversationId.

// ---------- Enums ----------
enum PlatformRole {
  USER
  PLATFORM_ADMIN
}
enum OrgStatus {
  ACTIVE
  SUSPENDED
}
enum MemberRole {
  OWNER
  ADMIN
  AGENT
  VIEWER
}
enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}
enum PlanKey {
  FREE
  PRO
  BUSINESS
}
enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
}
enum DocumentSourceType {
  FILE
  URL
  TEXT
}
enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}
enum ConversationStatus {
  BOT_ACTIVE
  NEEDS_HUMAN
  HUMAN_ACTIVE
  CLOSED
}
enum MessageRole {
  USER
  ASSISTANT
  AGENT
  SYSTEM
  TOOL
}
enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}
enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}
enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}
enum ToolCallStatus {
  PENDING_CONFIRMATION
  SUCCEEDED
  FAILED
  REJECTED
}
enum JobType {
  INGEST_DOCUMENT
  SUMMARIZE_CONVERSATION
  DETECT_KNOWLEDGE_GAPS
  SEND_NOTIFICATION
  WEEKLY_DIGEST
  PURGE_ORGANIZATION
}
enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}
enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}
enum UsageMetric {
  MESSAGES
  TOKENS_IN
  TOKENS_OUT
  DOCUMENTS
  BOTS
  SEATS
}

// ---------- Identity ----------
model User {
  id           String       @id @onCreate(cuid(2))
  email        String       @unique
  name         String
  passwordHash String
  platformRole PlatformRole @default(USER) // PLATFORM_ADMIN => /admin/* access
  emailVerifiedAt DateTime?
  disabledAt   DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @onCreate(now()) @onUpdate(now())

  memberships   Membership[]
  refreshTokens RefreshToken[]
  emailTokens   EmailToken[]
  assignedConversations Conversation[] @relation("ConversationAssignee")
  assignedTickets       Ticket[]       @relation("TicketAssignee")
}

model RefreshToken {
  id         String    @id @onCreate(cuid(2))
  userId     String
  familyId   String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  revokedAt  DateTime?
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @onCreate(now()) @onUpdate(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([expiresAt])
}

model EmailToken {
  id        String         @id @onCreate(cuid(2))
  userId    String
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @onCreate(now()) @onUpdate(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ---------- Tenancy ----------
model Organization {
  id               String    @id @onCreate(cuid(2))
  name             String
  slug             String    @unique
  status           OrgStatus @default(ACTIVE) // SUSPENDED by platform admin
  stripeCustomerId String?   @unique
  deletedAt        DateTime? // soft delete (hidden everywhere, restorable)
  purgeAfter       DateTime? // hard-delete job runs after this (e.g. +30 days)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @onCreate(now()) @onUpdate(now())

  memberships   Membership[]
  invitations   Invitation[]
  bots          Bot[]
  subscriptions Subscription[]
  usage         UsageRecord[]
  auditLogs     AuditLog[]
  jobs          ProcessingJob[]
  tickets       Ticket[]
  leads         Lead[]

  @@index([deletedAt])
}

model Membership {
  id             String     @id @onCreate(cuid(2))
  userId         String
  organizationId String
  role           MemberRole
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @onCreate(now()) @onUpdate(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Invitation {
  id             String     @id @onCreate(cuid(2))
  organizationId String
  email          String
  role           MemberRole
  tokenHash      String     @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @onCreate(now()) @onUpdate(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
}

// ---------- Bots & knowledge ----------
model Bot {
  id              String    @id @onCreate(cuid(2))
  organizationId  String
  name            String
  publicKey       String    @unique // safe to embed in widget
  systemPrompt    String    @default("")
  welcomeMessage  String    @default("Hi! How can I help?")
  theme           Json      @default(json`{}`)
  allowedDomains  String[]
  enabledTools    String[]
  embeddingModel  String    // chunks must match; re-embed when changed
  isActive        Boolean   @default(true)
  handoffEnabled  Boolean   @default(true)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @onCreate(now()) @onUpdate(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  documents     Document[]
  conversations Conversation[]

  @@unique([id, organizationId]) // target for composite FKs
  @@index([organizationId, deletedAt])
}

model Document {
  id                   String             @id @onCreate(cuid(2))
  organizationId       String
  botId                String
  title                String
  sourceType           DocumentSourceType
  sourceUrl            String?
  mimeType             String?
  fileSize             Int?
  checksum             String?            // sha256 of content; dedupe per bot
  extractedText        String?            // kept so re-chunking needs no original file
  status               DocumentStatus     @default(PENDING)
  errorCode            String?
  errorMessage         String?
  retryCount           Int                @default(0)
  chunkCount           Int                @default(0)
  processingStartedAt  DateTime?
  processedAt          DateTime?
  deletedAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @onCreate(now()) @onUpdate(now())
  bot                  Bot                @relation(fields: [botId, organizationId], references: [id, organizationId], onDelete: Cascade)
  chunks               Chunk[]

  @@unique([id, organizationId, botId])
  @@unique([botId, checksum])
  @@index([organizationId, botId, status])
}

model Chunk {
  id             String   @id @onCreate(cuid(2))
  organizationId String
  botId          String
  documentId     String
  position       Int
  content        String
  tokenCount     Int?
  pageNumber     Int?
  embedding      Raw(sql`vector(768)`)?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @onCreate(now()) @onUpdate(now())
  document       Document @relation(fields: [documentId, organizationId, botId], references: [id, organizationId, botId], onDelete: Cascade)

  @@index([organizationId, botId])
  @@index([documentId, position])
  // SQL migration adds: HNSW index on embedding (vector_cosine_ops) + GIN index on to_tsvector(content)
}

// ---------- Conversations ----------
model Conversation {
  id                  String             @id @onCreate(cuid(2))
  organizationId      String
  botId               String
  visitorId           String
  status              ConversationStatus @default(BOT_ACTIVE)
  assignedToId        String?            // human agent (User) who took over
  visitorName         String?
  visitorEmail        String?
  origin              String?
  summary             String?
  sentiment           Sentiment?
  tags                String[]
  csatScore           Int?
  firstResponseAt     DateTime?
  lastMessageAt       DateTime           @default(now())
  visitorLastSeenAt   DateTime?          // read-state for visitor side
  agentLastReadAt     DateTime?          // read-state for agent inbox (unread = lastMessageAt > agentLastReadAt)
  closedAt            DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @onCreate(now()) @onUpdate(now())
  bot                 Bot                @relation(fields: [botId, organizationId], references: [id, organizationId], onDelete: Cascade)
  assignedTo          User?              @relation("ConversationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  messages  Message[]
  toolCalls ToolCall[]

  @@unique([id, organizationId])
  @@index([organizationId, status, lastMessageAt])
  @@index([botId, createdAt])
  @@index([assignedToId])
}

model Message {
  id             String      @id @onCreate(cuid(2))
  organizationId String
  conversationId String
  role           MessageRole
  content        String
  citations      Json?
  model          String?
  tokensIn       Int?
  tokensOut      Int?
  latencyMs      Int?
  retrievalScore Float?      // top retrieval score; low => knowledge gap
  feedback       Int?        // -1, 0, 1
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @onCreate(now()) @onUpdate(now())
  conversation   Conversation @relation(fields: [conversationId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([organizationId, createdAt])
}

model ToolCall {
  id             String         @id @onCreate(cuid(2))
  organizationId String
  conversationId String
  toolName       String
  input          Json
  output         Json?
  status         ToolCallStatus
  error          String?
  durationMs     Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @onCreate(now()) @onUpdate(now())
  conversation   Conversation   @relation(fields: [conversationId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, toolName, createdAt])
}

model Ticket {
  id             String         @id @onCreate(cuid(2))
  organizationId String
  conversationId String?        // optional: composite FK enforced in SQL migration
  subject        String
  summary        String?
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(NORMAL)
  assignedToId   String?
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @onCreate(now()) @onUpdate(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo     User?          @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, priority])
}

model Lead {
  id             String       @id @onCreate(cuid(2))
  organizationId String
  conversationId String?      // optional: composite FK enforced in SQL migration
  name           String
  email          String
  message        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @onCreate(now()) @onUpdate(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// ---------- Billing ----------
// An org can have MANY subscription rows over time (history), but at most ONE "live" one:
// SQL migration adds a partial unique index on (organizationId) WHERE status IN
// ('INCOMPLETE','TRIALING','ACTIVE','PAST_DUE','UNPAID','PAUSED').
model Subscription {
  id                   String             @id @onCreate(cuid(2))
  organizationId       String
  stripeSubscriptionId String             @unique
  stripePriceId        String
  plan                 PlanKey
  status               SubscriptionStatus
  cancelAtPeriodEnd    Boolean            @default(false)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  trialEnd             DateTime?
  canceledAt           DateTime?
  endedAt              DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @onCreate(now()) @onUpdate(now())
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events               SubscriptionEvent[]

  @@index([organizationId, status])
}

// Append-only history: every plan/status change is recorded (powers "billing history" UI + admin view).
model SubscriptionEvent {
  id              String              @id @onCreate(cuid(2))
  subscriptionId  String
  organizationId  String
  fromPlan        PlanKey?
  toPlan          PlanKey
  fromStatus      SubscriptionStatus?
  toStatus        SubscriptionStatus
  stripeEventId   String?             @unique
  occurredAt      DateTime
  createdAt       DateTime            @default(now())
  subscription    Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt])
}

// type stays String on purpose: Stripe's event types are an open, growing set.
model WebhookEvent {
  id          String             @id // Stripe event id = idempotency key
  type        String
  status      WebhookEventStatus @default(RECEIVED)
  attempts    Int                @default(0)
  error       String?
  payload     Json?
  receivedAt  DateTime           @default(now())
  processedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @onCreate(now()) @onUpdate(now())

  @@index([status, receivedAt])
}

model UsageRecord {
  id             String       @id @onCreate(cuid(2))
  organizationId String
  metric         UsageMetric
  periodStart    DateTime     // first day of billing month (UTC)
  count          BigInt       @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @onCreate(now()) @onUpdate(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metric, periodStart])
}

// ---------- Ops ----------
// action stays String ("bot.deleted", "member.role_changed", ...): open set, namespaced.
model AuditLog {
  id             String    @id @onCreate(cuid(2))
  organizationId String?   // null for platform-level actions
  actorId        String?
  actorType      String    @default("user") // user | platform_admin | system
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  ip             String?
  createdAt      DateTime  @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([action, createdAt])
}

// Durable, tenant-visible record of background work (queue itself lives in pg-boss).
model ProcessingJob {
  id             String    @id @onCreate(cuid(2))
  organizationId String?
  type           JobType
  status         JobStatus @default(QUEUED)
  queueJobId     String?
  entityType     String?
  entityId       String?
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  error          String?
  payload        Json?
  result         Json?
  scheduledAt    DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @onCreate(now()) @onUpdate(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, type, status])
  @@index([entityType, entityId])
}